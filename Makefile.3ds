# Nintendo 3DS (New 3DS) build of Dolmexica Infinite, with devkitARM,
# libctru and citro3d, on prism's 3DS backend (prism's Makefile.3ds).
#
# Usage (devkitPro environment): make -f Makefile.3ds -j$(nproc)
# Makes dolmexica.3dsx (and dolmexica.elf, for the .cia).

include Makefile.common

PRISM_PATH ?= ../prism

OBJDIR = build_3ds
PRISM_BIN = bin_3ds
NAME = dolmexica
# LINEAR_DIAG=1: the linear memory's diagnosis (prism's 3ds/lineardiag_3ds.cpp),
# as dolmexica-diag.3dsx, with prism built the same (LINEAR_DIAG=1 there too).
ifdef LINEAR_DIAG
OBJDIR = build_3ds_diag
PRISM_BIN = bin_3ds_diag
NAME = dolmexica-diag
endif
ALL_OBJS = $(addprefix $(OBJDIR)/,$(OBJS) pausemenu3ds.o fighttrace3ds.o characterautodetect.o)

DEVKITPRO ?= /opt/devkitpro
PREFIX = $(DEVKITPRO)/devkitARM/bin/arm-none-eabi-
CXX = $(PREFIX)g++

ARCH = -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
CXXFLAGS = $(ARCH) -std=gnu++17 -fsigned-char -fpermissive -O2 -g -mword-relocations -ffunction-sections \
	-Wno-write-strings -D__3DS__ -DDOLMEXICA_CHARACTER_AUTODETECT -I$(PRISM_PATH)/include -I$(PRISM_PATH)/linux/shim -I. \
	-I$(DEVKITPRO)/libctru/include -I$(DEVKITPRO)/portlibs/3ds/include
LDFLAGS = $(ARCH) -specs=3dsx.specs -g -Wl,--gc-sections \
	-L$(PRISM_PATH)/$(PRISM_BIN) -L$(DEVKITPRO)/portlibs/3ds/lib -L$(DEVKITPRO)/libctru/lib
LIBS = -lprism -lpng -lzstd -lz -lmpg123 -lvorbisidec -logg -lcitro3d -lctru -lm
ifdef LINEAR_DIAG
CXXFLAGS += -DN3DS_LINEAR_DIAG
LDFLAGS += -Wl,--wrap=linearAlloc,--wrap=linearMemAlign,--wrap=linearFree,--wrap=malloc,--wrap=free,--wrap=calloc,--wrap=realloc,--wrap=memalign,--wrap=_malloc_r,--wrap=_free_r,--wrap=_calloc_r,--wrap=_realloc_r,--wrap=_memalign_r
endif

APP_TITLE = Dolmexica Infinite
APP_DESCRIPTION = MUGEN-compatible fighting game engine
APP_AUTHOR = CaptainDreamcast, AlexanderV387
ICON = 3ds/icon.png
ROMFS = $(OBJDIR)/romfs

all: $(NAME).3dsx

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(NAME).elf: $(ALL_OBJS) $(PRISM_PATH)/$(PRISM_BIN)/libprism.a
	$(CXX) $(LDFLAGS) $(ALL_OBJS) $(LIBS) -o $@

# prism's own files (the fonts) in the romfs, as "$/rd/".
$(ROMFS): $(PRISM_PATH)/assets/fonts/segoe.hdr $(PRISM_PATH)/assets/fonts/segoe.png
	@mkdir -p $(ROMFS)/fonts
	cp $^ $(ROMFS)/fonts/
	@touch $(ROMFS)

dolmexica.smdh: $(ICON)
	$(DEVKITPRO)/tools/bin/smdhtool --create "$(APP_TITLE)" "$(APP_DESCRIPTION)" "$(APP_AUTHOR)" $(ICON) $@

$(NAME).3dsx: $(NAME).elf dolmexica.smdh $(ROMFS)
	$(DEVKITPRO)/tools/bin/3dsxtool $< $@ --smdh=dolmexica.smdh --romfs=$(ROMFS)

# Rebuilt when a header they use changes.
-include $(shell find $(OBJDIR) -name '*.d' 2>/dev/null)

clean:
	rm -rf $(OBJDIR) dolmexica.elf dolmexica.3dsx dolmexica.smdh

.PHONY: all clean
